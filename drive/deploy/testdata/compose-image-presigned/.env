# Generated by `drive init --target compose --delivery presigned --image ghcr.io/shibukawa/streamuploader-drive:v0.1.0 --name mydrive --port 18080`.
# docker compose reads this file for compose.yaml and passes it whole to the
# drive container (env_file), so it is the one place to change a setting.
# Re-running `drive init --force` regenerates it from the flags.

# --- docker compose
COMPOSE_PROJECT_NAME=mydrive
DRIVE_IMAGE=ghcr.io/shibukawa/streamuploader-drive:v0.1.0
DRIVE_PORT=18080
RUSTFS_IMAGE=rustfs/rustfs:latest
# RUSTFS_PORT must match the port in SU_S3_PUBLIC_ENDPOINT below.
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# --- streamuploader: upload intake, object store, derived assets
SU_ADDR=:8080
SU_PUBLIC_BASE_URL=http://localhost:18080
SU_S3_BUCKET=drive
SU_S3_ENDPOINT=http://rustfs:9000
# Browser-facing endpoint, used only by presigned delivery.
SU_S3_PUBLIC_ENDPOINT=http://localhost:9000
SU_S3_REGION=us-east-1
SU_S3_FORCE_PATH_STYLE=true
# Development credentials of the local RustFS container; rustfs reads the
# same two values, so change them together.
SU_S3_ACCESS_KEY_ID=rustfsadmin
SU_S3_SECRET_ACCESS_KEY=rustfsadmin
SU_SECURITY_CONFIG=/etc/drive/security.yaml
SU_LOG_LEVEL=info

# --- Drive
DRIVE_TENANT=default
DRIVE_PREFIX=drive/
DRIVE_INDEX_DIR=/tmp/drive-index
DRIVE_INDEX_INTERVAL=30s
DRIVE_SEARCH_TOKENIZER=lindera
DRIVE_DELIVERY=presigned
